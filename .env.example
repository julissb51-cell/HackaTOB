# Copia este archivo a web/.env.local y pon tus claves ahí.
# .env no se sube al repo. Estos valores son solo de ejemplo.
# Next.js lee las variables desde web/, no desde la raíz del repo.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role

# Analista. gemini es el valor por defecto (nivel gratuito).
# La clave se crea en https://aistudio.google.com/apikey
# xai usa Grok en https://api.x.ai/v1
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_clave_gemini
XAI_API_KEY=tu_clave_xai
